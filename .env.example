# ─── DATABASE ──────────────────────────────────────────────
# PostgreSQL connection — database name is "apcode"
DB_HOST=localhost
DB_PORT=5432
DB_NAME=apcode
DB_USER=postgres
DB_PASSWORD=your_postgres_password_here

# ─── JWT ───────────────────────────────────────────────────
# Change this to a long random secret string in production
JWT_SECRET=apcode_super_secret_jwt_key_change_in_production_2026

# JWT expiry (e.g. 7d, 24h, 30d)
JWT_EXPIRES_IN=7d

# ─── SERVER ────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── ADMIN ─────────────────────────────────────────────────
# This is the admin panel password (same as the one in index.html)
ADMIN_PASSWORD=APcode@2026
